{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{data/catalogue.json,server/schema.sql,server/postgres-security.sql,dist/index.html}",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api?api_path=/api/$1"
    },
    {
      "src": "/robots.txt",
      "dest": "/api?api_path=/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api?api_path=/sitemap.xml"
    },
    {
      "src": "/",
      "dest": "/api?render_path=/"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api?render_path=/$1"
    }
  ],
  "installCommand": "npm ci --include=dev"
}
