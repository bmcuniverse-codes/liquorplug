# Node 22.13+ or 24. Copy this file to .env.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
# Leave blank for persistent local SQLite. Use a PostgreSQL connection string in production.
DATABASE_URL=
DATABASE_SSL=false
# Supabase: true above; paste the entire downloaded certificate inside double quotes.
# Include -----BEGIN CERTIFICATE----- and -----END CERTIFICATE----- with actual line breaks.
DATABASE_CA_CERT=
SQLITE_PATH=./data/liquor-plug.sqlite
OWNER_EMAIL=
OWNER_PASSWORD=
PAYSTACK_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAIL=
# Production serverless deployments need public S3-compatible object storage for uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Random value for authenticated scheduled maintenance calls (at least 32 characters).
CRON_SECRET=
