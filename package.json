{
  "name": "liquor-plug",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs --production",
    "db:setup": "node --env-file-if-exists=.env scripts/setup.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@sentry/browser": "^11.8.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "10.1.7",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "supertest": "^7.1.4",
    "vite": "^7.1.10"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
